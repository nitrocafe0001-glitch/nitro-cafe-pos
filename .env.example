# Copy this file to .env. Never share or commit the real .env file.
PORT=3000
# Shared login password for the shop computer and all mobile devices (minimum 8 characters)
POS_SHARED_PASSWORD=CHANGE_THIS_TO_A_LONG_PRIVATE_PASSWORD
# On hosts with persistent disks, set DATA_DIR to the mounted persistent folder, e.g. /var/data
# DATA_DIR=/var/data
DEFAULT_COUNTRY_CODE=91
WHATSAPP_ACCESS_TOKEN=PASTE_PRIVATE_META_ACCESS_TOKEN_HERE
WHATSAPP_PHONE_NUMBER_ID=PASTE_PHONE_NUMBER_ID_HERE
GRAPH_API_VERSION=vXX.X
WHATSAPP_TEMPLATE_LANGUAGE=en
# Create and get approval for two templates with exactly 3 BODY parameters each.
# Bill template parameter order: customer name, bill number, total.
WHATSAPP_BILL_TEMPLATE=nitro_bill_receipt
# Food-ready template parameter order: customer name, order/bill number, shop name.
WHATSAPP_FOOD_READY_TEMPLATE=nitro_food_ready
